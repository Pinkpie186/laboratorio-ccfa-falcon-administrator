{
  "name": "falcon-admin-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:local": "node scripts/start-local.js",
    "worker": "node src/worker.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "sync:docs": "node scripts/sync-docs.js",
    "sync:library": "node scripts/sync-library.js",
    "generate:questions": "node scripts/generate-cited-questions.js",
    "generate:ccfa-bank": "node scripts/generate-ccfa-bank.js",
    "import:certification-simulations": "node scripts/import-certification-simulations.js",
    "import:english-package": "node scripts/import-english-certification-package.js",
    "verify:english-package": "node scripts/verify-english-package-import.js",
    "report:ccfa-bank": "node scripts/report-ccfa-bank.js",
    "test": "node --test --test-reporter=spec tests/*.test.js",
    "test:integration": "RUN_DB_TESTS=1 node --test --test-reporter=spec tests/integration.test.js tests/platform-integration.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "csv-stringify": "^6.6.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "mammoth": "^1.10.0",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "sanitize-html": "^2.17.0",
    "tesseract.js": "^6.0.1",
    "zod": "^4.0.17"
  }
}
