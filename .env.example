NODE_ENV=development
PORT=8080
APP_ORIGIN=http://localhost:8080
DATABASE_URL=postgresql://falcon_app:change-me@localhost:5432/falcon_admin
DATABASE_SSL=false
SESSION_COOKIE_NAME=falcon_session
SESSION_TTL_HOURS=12
BCRYPT_ROUNDS=12
TRUST_PROXY=false
DEMO_REVIEWER_PASSWORD=
DEMO_ANALYST_PASSWORD=
DEMO_MANAGER_PASSWORD=

# Local private storage (default) or S3-compatible object storage.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage/private
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=falcon-admin-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Optional corporate integrations. Secrets belong only in the backend environment.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OUTLOOK_OAUTH_CLIENT_ID=
OUTLOOK_OAUTH_CLIENT_SECRET=
SSO_ISSUER=
SCIM_BEARER_TOKEN=

# Import worker. Never place CrowdStrike credentials here; browser-assisted imports use exported files.
DOC_SYNC_BATCH_SIZE=25
DOC_SYNC_RATE_PER_MINUTE=30
DOC_SYNC_RETRY_LIMIT=3
DOCS_ROOT=/source-docs
PUBLIC_SYNC_ENABLED=true
PUBLIC_SYNC_DELAY_MS=1000
PUBLIC_SYNC_ALLOWLIST=crowdstrike.com,www.crowdstrike.com,developer.crowdstrike.com,docs.crowdstrike.com,university.crowdstrike.com
PROCESSING_MODE=local
CORPORATE_AI_ENDPOINT=
CORPORATE_AI_TOKEN=
